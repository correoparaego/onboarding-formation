# Django settings
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=onboarding
POSTGRES_USER=onboarding_user
POSTGRES_PASSWORD=change-me

# Frontend URL (for CORS)
FRONTEND_BASE_URL=http://localhost:5173

# DNI Encryption Key (generate a secure random key)
DNI_ENCRYPTION_KEY=change-me-32-chars-minimum

# Gemini API (default LLM for course generation)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# AI Generation (set to False to use real LLM)
AI_USE_FAKE_LLM=False

# Email transport (console, smtp, resend)
EMAIL_TRANSPORT=console
